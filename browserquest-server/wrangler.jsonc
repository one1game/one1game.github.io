{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "one1game-browserquest",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD",
        "class_name": "WorldDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorldDO"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
