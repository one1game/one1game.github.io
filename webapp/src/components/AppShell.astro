          <div class="rel-nav">
            <button class="rel-nav__btn" id="rel-prev" type="button" aria-label="Предыдущие материалы">←</button>
            <button class="rel-nav__btn" id="rel-next" type="button" aria-label="Следующие материалы">→</button>
          </div>
        </div>
        <div class="reader__related-list" id="r-related-list">
          {relatedItems.map((rel) => (
            <a class="rel" href={`${base}/news/${rel.slug}/`} data-slug={rel.slug}>
              <span class="rel__thumb">
                {rel.image
                  ? <img src={rel.image} alt="" width="320" height="180" loading="lazy" decoding="async" />
                  : <span class="rel__thumb-empty" aria-hidden="true">{rel.category.slice(0, 2)}</span>}
              </span>
              <span class="rel__body">
                <span class="rel__cat">{rel.category}</span>
                <span class="rel__title">{rel.title}</span>
