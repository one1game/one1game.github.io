  <nav class="tabbar" id="chips" aria-label="Разделы">
    <div class="wrap chips" data-chips="news" hidden={mode !== 'news'}>
      <button class="chip" type="button" data-cat="all" aria-pressed={String(activeCat === 'all')}>Все</button>
