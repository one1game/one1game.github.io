---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import catalog from '../data/catalog.json';
import navigator from '../data/navigator.json';
import oboi from '../data/oboi.json';
import movies from '../data/movies.json';
import { historyByDay } from '../data/gaming-history';

type Mode = 'news' | 'music' | 'nav' | 'oboi' | 'movie';

interface Props {
  mode?: Mode;
  cat?: string;
  post?: string;
  movie?: string;
  variant?: 'app' | 'section' | 'item' | 'movie-item';
  seoTitle?: string;
  seoDescription?: string;
  seoImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  postData?: any;
  movieData?: any;
  walls?: any[];
  tracks?: any[];
}

const {
  mode = 'news',
  cat = '',
  post = '',
  movie = '',
  variant = 'app',
  seoTitle,
  seoDescription,
  seoImage,
  noindex = false,
  jsonLd,
  postData,
  movieData,
  walls = [],
  tracks = [],
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { items, categories, stats } = catalog;

const isItem = variant === 'item';
const isMovieItem = variant === 'movie-item';
const showNews = variant === 'app';
const showMusic = variant === 'app' || (variant === 'section' && mode === 'music');
const showNav = variant === 'app' || (variant === 'section' && mode === 'nav');
const showOboi = variant === 'app' || (variant === 'section' && mode === 'oboi');
const showMovies = variant === 'app' || (variant === 'section' && mode === 'movie');

const catLabel = oboi.categories.find((c) => c.key === cat)?.label || cat;
const navKey = ['giveaways', 'deals', 'lowend', 'random'].includes(cat) ? cat : '';
const movieSection = ['upcoming', 'released'].includes(cat) ? cat : '';
const activeCat = cat || 'all';
const h1 = postData
  ? postData.title
  : movieData
    ? movieData.title
    : mode === 'music'
      ? 'Музыка для игр — слушать онлайн'
      : mode === 'nav'
        ? 'Игровой навигатор: скидки, раздачи и подборки'
        : mode === 'oboi'
          ? cat && cat !== 'all' ? `Обои: ${catLabel}` : 'Обои для рабочего стола и телефона'
          : mode === 'movie'
            ? 'Фильмы по играм: экранизации и новинки'
            : 'One1Game — новости игр, гайды, обзоры и обои';

const catalogMeta = JSON.stringify(
  items.map(({ slug, title, excerpt, category, date, read, image }) => ({
    slug, title, excerpt, category, date, read, image,
  })),
);

const movieMeta = JSON.stringify(
  movies.items.map(({ id, title, section, date, overview, poster, rating }) => ({
    id, title, section, date, overview, poster, rating,
  })),
);

const relatedItems = postData?.related
  ? postData.related
      .map((rel: any) => items.find((item) => item.slug === rel.slug))
      .filter(Boolean)
      .slice(0, 6)
  : [];

const bodyData: Record<string, string> = {
  mode,
  variant,
};
if (cat) bodyData.cat = cat;
if (post) bodyData.post = post;
if (movie) bodyData.movie = movie;

// Информер: событие этого дня в истории игр (курс биткоина подтягивается на клиенте).
const pad2 = (n: number) => String(n).padStart(2, '0');
const buildDay = new Date();
const tickerDay = `${pad2(buildDay.getMonth() + 1)}-${pad2(buildDay.getDate())}`;
const tickerEvent = historyByDay[tickerDay];

// Заголовок списка меняется вместе с разделом.
const listTitle =
  mode === 'music'
    ? 'Музыка для игр'
    : mode === 'nav'
      ? 'Навигатор по играм'
      : mode === 'oboi'
        ? 'Обои и подборки'
        : mode === 'movie'
          ? 'Фильмы по играм'
          : 'Свежие материалы';

const plural = (n: number, one: string, few: string, many: string) => {
  const m10 = n % 10;
  const m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return few;
  return many;
};

const navCount = (collection: { key: string; count: number }) => {
  if (collection.key === 'random') return 'Рандомайзер';
  if (collection.key === 'lowend') return `${collection.count} ${plural(collection.count, 'игра', 'игры', 'игр')}`;
  return `${collection.count} ${plural(collection.count, 'предложение', 'предложения', 'предложений')}`;
};

// Для карточки скидки показываем реальные данные Steam, а не dealRating.
const dealInfo = (deal: any) => {
  const parts: string[] = [];
  if (deal.release) parts.push(String(new Date(deal.release * 1000).getFullYear()));
  if (deal.ratingPercent) parts.push(`${deal.ratingText || 'Steam'} · ${deal.ratingPercent}%`);
  else if (deal.ratingText) parts.push(deal.ratingText);
  if (deal.metacritic) parts.push(`Metacritic ${deal.metacritic}`);
  return parts.length ? parts.join(' · ') : 'Скидка дня в Steam';
};

const dealTitle = (deal: any) => {
  const parts: string[] = [];
  if (deal.ratingCount) parts.push(`Отзывов Steam: ${deal.ratingCount}`);
  if (deal.dealRating) parts.push(`Оценка сделки CheapShark: ${deal.dealRating}/10`);
  return parts.join('. ');
};

// Полный список жанров Audius (docs: components.schemas.genre).
// В приложении музыка тянется из их API, а не из статического снимка.
const genres = [
  { value: 'Electronic', label: 'Electronic' },
  { value: 'Hip-Hop/Rap', label: 'Hip-Hop' },
  { value: 'Rock', label: 'Rock' },
  { value: 'Pop', label: 'Pop' },
  { value: 'Lo-Fi', label: 'Lo-Fi' },
  { value: 'Ambient', label: 'Ambient' },
  { value: 'House', label: 'House' },
  { value: 'Techno', label: 'Techno' },
  { value: 'Trap', label: 'Trap' },
  { value: 'Drum & Bass', label: 'Drum & Bass' },
  { value: 'Dubstep', label: 'Dubstep' },
  { value: 'R&B/Soul', label: 'R&B' },
  { value: 'Jazz', label: 'Jazz' },
  { value: 'Classical', label: 'Classical' },
  { value: 'Reggae', label: 'Reggae' },
  { value: 'Latin', label: 'Latin' },
  { value: 'Metal', label: 'Metal' },
  { value: 'Alternative', label: 'Alternative' },
  { value: 'Punk', label: 'Punk' },
  { value: 'Folk', label: 'Folk' },
  { value: 'Acoustic', label: 'Acoustic' },
  { value: 'Funk', label: 'Funk' },
  { value: 'Blues', label: 'Blues' },
  { value: 'Country', label: 'Country' },
  { value: 'World', label: 'World' },
  { value: 'Soundtrack', label: 'Soundtrack' },
  { value: 'Experimental', label: 'Experimental' },
  { value: 'Downtempo', label: 'Downtempo' },
  { value: 'Trance', label: 'Trance' },
  { value: 'Hardstyle', label: 'Hardstyle' },
  { value: 'Hyperpop', label: 'Hyperpop' },
  { value: 'Vaporwave', label: 'Vaporwave' },
  { value: 'Disco', label: 'Disco' },
  { value: 'Electro', label: 'Electro' },
  { value: 'Jungle', label: 'Jungle' },
  { value: 'Glitch Hop', label: 'Glitch Hop' },
  { value: 'Future Bass', label: 'Future Bass' },
  { value: 'Moombahton', label: 'Moombahton' },
  { value: 'Dancehall', label: 'Dancehall' },
  { value: 'Deep House', label: 'Deep House' },
  { value: 'Tech House', label: 'Tech House' },
  { value: 'Progressive House', label: 'Progressive House' },
  { value: 'Future House', label: 'Future House' },
  { value: 'Tropical House', label: 'Tropical House' },
  { value: 'Jersey Club', label: 'Jersey Club' },
];
---

<Base
  title={seoTitle || `${h1} — One1Game`}
  description={seoDescription}
  noindex={noindex}
  image={seoImage}
  ogType={postData ? 'article' : movieData ? 'video.movie' : 'website'}
  jsonLd={jsonLd}
  bodyData={bodyData}
  articleMeta={postData ? { published: postData.dateISO, section: postData.category, author: 'One1Game' } : undefined}
>
  <header class="appbar">
    <div class="wrap appbar-row">
      <a class="brand" href={`${base}/`}>
        <span class="brand-mark" aria-hidden="true">1</span>
        <span class="brand__text">One1<b>Game</b></span>
      </a>
      <div class="appbar-actions">
        <nav class="socials" aria-label="One1Game в соцсетях">
          <a
            class="social"
            href="https://www.youtube.com/@one1game"
            target="_blank"
            rel="noopener"
            aria-label="YouTube"
            title="YouTube"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12z" />
            </svg>
          </a>
          <a
            class="social"
            href="https://t.me/one1game"
            target="_blank"
            rel="noopener"
            aria-label="Telegram"
            title="Telegram"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9.04 15.36 8.7 20c.5 0 .72-.22.98-.48l2.36-2.27 4.9 3.6c.9.5 1.54.24 1.78-.83l3.22-15.1c.3-1.35-.49-1.88-1.37-1.55L1.4 9.66C.08 10.18.1 10.93 1.18 11.26l5.1 1.6L18.1 5.1c.56-.37 1.07-.17.65.2z" />
            </svg>
          </a>
          <a
            class="social"
            href="https://vk.com/one1games"
            target="_blank"
            rel="noopener"
            aria-label="ВКонтакте"
            title="ВКонтакте"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M13.16 18.02c-5.7 0-8.95-3.9-9.08-10.4h2.86c.09 4.77 2.2 6.79 3.87 7.2V7.62h2.69v4.11c1.65-.18 3.38-2.06 3.96-4.11h2.69c-.45 2.53-2.33 4.41-3.67 5.18 1.34.62 3.48 2.26 4.29 5.22h-2.96c-.64-2-2.23-3.55-4.31-3.76v3.76h-.34z" />
            </svg>
          </a>
        </nav>
        <button class="btn" data-install type="button" aria-label="Установить приложение" hidden><span class="install-label">Установить</span></button>
      </div>
    </div>
  </header>

  <!-- Информер: событие этого дня в истории игр и курс биткоина (курс приезжает с API). -->
  <div class="ticker">
    <div class="wrap ticker-row">
      <p class="ticker__news" id="ticker-news" data-day={tickerDay}>
        <span class="ticker__ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7.5V12l3 1.8"/><circle cx="12" cy="12" r="8.2"/></svg>
        </span>
        <span class="ticker__stack">
          <span class="ticker__meta">
            <span class="ticker__label">Этот день в играх</span>
            <span class="ticker__year" id="ticker-year">{tickerEvent?.y}</span>
          </span>
          <span class="ticker__viewport" id="ticker-viewport">
            <span
              class="ticker__text"
              id="ticker-text"
              title={tickerEvent ? `${tickerEvent.y} · ${tickerEvent.t} — ${tickerEvent.d}` : 'Событие этого дня в истории игровой индустрии'}
            >{tickerEvent ? tickerEvent.d : 'Событие этого дня в истории игровой индустрии'}</span>
          </span>
        </span>
      </p>
      <p class="ticker__btc" id="ticker-btc" hidden>
        <span class="ticker__stack">
          <span class="ticker__label">BTC · USD</span>
          <span class="ticker__price">
            <span class="ticker__text" id="ticker-btc-price">—</span>
            <span class="ticker__delta" id="ticker-btc-delta"></span>
          </span>
        </span>
      </p>
    </div>
  </div>

  <!-- Верхний уровень: публикации, музыка, навигатор, обои и фильмы. -->
  <nav class="modes" id="modes" aria-label="Тип контента">
    <div class="wrap modes-row">
      <a class="mode" href={`${base}/`} data-mode="news" aria-label="Публикации" aria-pressed={String(mode === 'news')} aria-current={mode === 'news' ? 'page' : undefined}>
        <svg class="mode__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 4h9l4 4v12a1.5 1.5 0 0 1-1.5 1.5H5.5A1.5 1.5 0 0 1 4 20V5.5A1.5 1.5 0 0 1 5.5 4Z"/><path d="M14 4v4.5h4.5M8 12.5h8M8 16h5.5"/></svg>
        <span class="mode__label">Публикации</span>
      </a>
      <a class="mode" href={`${base}/music/`} data-mode="music" aria-label="Музыка" aria-pressed={String(mode === 'music')} aria-current={mode === 'music' ? 'page' : undefined}>
        <svg class="mode__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="17.2" r="2.6"/><circle cx="17.4" cy="15" r="2.6"/><path d="M9.6 17.2V6.6l10.4-2v10.4"/></svg>
        <span class="mode__label">Музыка</span>
      </a>
      <a class="mode" href={`${base}/nav/`} data-mode="nav" aria-label="Игровой навигатор" aria-pressed={String(mode === 'nav')} aria-current={mode === 'nav' ? 'page' : undefined}>
        <svg class="mode__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.6"/><path d="M15.1 8.9l-1.8 4.4-4.4 1.8 1.8-4.4z"/></svg>
        <span class="mode__label">Игровой навигатор</span>
      </a>
      <a class="mode" href={`${base}/oboi/`} data-mode="oboi" aria-label="Обои" aria-pressed={String(mode === 'oboi')} aria-current={mode === 'oboi' ? 'page' : undefined}>
        <svg class="mode__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2.6"/><circle cx="9" cy="9.8" r="1.6"/><path d="M4.6 17.2l4.6-4.6 3.2 3.2 3-3 4 4"/></svg>
        <span class="mode__label">Обои</span>
      </a>
      <a class="mode" href={`${base}/movie/`} data-mode="movie" aria-label="Фильмы по играм" aria-pressed={String(mode === 'movie')} aria-current={mode === 'movie' ? 'page' : undefined}>
        <svg class="mode__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2.6"/><path d="M8 5v14M16 5v14M3.5 9.7h4.5M3.5 14.3h4.5M16 9.7h4.5M16 14.3h4.5"/></svg>
        <span class="mode__label">Фильмы по играм</span>
      </a>
    </div>
  </nav>

  <main class="wrap" id="view-list" hidden={isItem || isMovieItem}>
    {!postData && !movieData && <h1 class="sr-only">{h1}</h1>}

    <div class="list-head">
      <h2 class="list-head__title">{listTitle}</h2>
      <span class="list-head__line" aria-hidden="true"></span>
      <p class="status" id="status" aria-live="polite">{stats.total} материалов</p>
    </div>

    <!-- Сортировка музыки: тренды недели, всё время, свежие загрузки. -->
    <div class="music-tools" id="music-tools" hidden={mode !== 'music'}>
      <div class="sorts" id="sorts" role="group" aria-label="Сортировка музыки">
        <button class="sort" type="button" data-sort="trending" aria-pressed="true">Тренды</button>
        <button class="sort" type="button" data-sort="popular" aria-pressed="false">За всё время</button>
        <button class="sort" type="button" data-sort="new" aria-pressed="false">Новинки</button>
      </div>
      <span class="music-tools__src">Audius API</span>
    </div>

    <div class="grid" id="grid" hidden={mode !== 'news'}>
      {showNews && items.map((item, i) => <Card item={item} priority={i < 4} />)}
    </div>

    <div class="grid music-grid" id="music-grid" hidden={mode !== 'music'}>
      {showMusic && tracks.map((track) => (
        <button
          class="track"
          type="button"
          data-track
          data-id={track.id}
          data-title={track.title}
          data-artist={track.artist}
          data-art={track.art}
          aria-label={`Слушать ${track.title}`}
        >
          <span class="track__art">
            {track.art && <img src={track.art} alt="" loading="lazy" decoding="async" width="480" height="480" />}
            <span class="track__play" aria-hidden="true"><span class="track__icon">▶</span></span>
          </span>
          <span class="track__body">
            <span class="track__title">{track.title}</span>
            <span class="track__artist">{track.artist}</span>
            <span class="track__meta">
              {track.genre || 'Музыка'} · {Math.floor((track.duration || 0) / 60)}:{String((track.duration || 0) % 60).padStart(2, '0')}
            </span>
          </span>
        </button>
      ))}
    </div>

    <div class="music-more" id="music-more-wrap" hidden>
      <button class="btn btn--ghost" id="music-more" type="button">Показать ещё</button>
    </div>

    <!-- Игровой навигатор: «Подборки» основного сайта. -->
    <div class="nav-hub" id="nav-hub" hidden={mode !== 'nav' || !!navKey}>
      {showNav && navigator.collections.map((collection) => (
        <button
          class="nav-hub__card"
          type="button"
          data-nav-go={collection.key}
          data-hay={`${collection.label} ${collection.desc}`.toLowerCase()}
        >
          {collection.image && (
            <span class="nav-hub__art" aria-hidden="true">
              <img
                src={collection.image}
                onerror="this.onerror=null;this.style.display='none'"
                alt=""
                width="616"
                height="353"
                loading="lazy"
                decoding="async"
              />
            </span>
          )}
          <span class="nav-hub__label">Подборка</span>
          <span class="nav-hub__title">{collection.label}</span>
          <span class="nav-hub__desc">{collection.desc}</span>
          <span class="nav-hub__count">{navCount(collection)} →</span>
        </button>
      ))}
    </div>

    <div class="grid nav-grid" id="nav-giveaways" hidden={mode !== 'nav' || navKey !== 'giveaways'}>
      {showNav && navigator.giveaways.map((giveaway) => (
        <a
          class="card nav-card"
          href={giveaway.url}
          target="_blank"
          rel="nofollow noopener"
          data-nav-item
          data-hay={`${giveaway.title} ${giveaway.platforms} ${giveaway.description}`.toLowerCase()}
        >
          <span class="card__thumb">
            {giveaway.image && (
              <img
                src={giveaway.image}
                data-fallback={`${base}/icon.svg`}
                onerror="const s=[this.dataset.fallback,this.dataset.fallback2,this.dataset.fallback3].filter(Boolean),i=+(this.dataset.step||0);if(i<s.length){this.dataset.step=i+1;this.src=s[i]}else{this.onerror=null}"
                alt={giveaway.title}
                loading="lazy"
                decoding="async"
                width="460"
                height="215"
              />
            )}
          </span>
          <span class="card__body">
            <span class="card__cat">Бесплатно · {giveaway.platforms}</span>
            <span class="card__title">{giveaway.title}</span>
            <span class="card__excerpt">{giveaway.description}</span>
            <span class="card__meta">
              {giveaway.worth ? `Было ${giveaway.worth} · ` : ''}
              {giveaway.end ? `до ${giveaway.end} · ` : ''}Забрать →
            </span>
          </span>
        </a>
      ))}
    </div>

    <div class="grid nav-grid" id="nav-deals" hidden={mode !== 'nav' || navKey !== 'deals'}>
      {showNav && navigator.deals.map((deal) => (
        <a
          class="card nav-card"
          href={deal.url}
          target="_blank"
          rel="nofollow noopener"
          data-nav-item
          data-hay={`${deal.title} ${dealInfo(deal)} скидка steam ${deal.discount}`.toLowerCase()}
          title={dealTitle(deal)}
        >
          <span class="card__thumb">
            {deal.image && (
              <img
                src={deal.image}
                class={deal.image.includes('capsule_231x87') ? 'is-lowres' : undefined}
                data-fallback={deal.imageFallback}
                data-fallback2={deal.thumb}
                data-fallback3={`${base}/icon.svg`}
                onerror="const s=[this.dataset.fallback,this.dataset.fallback2,this.dataset.fallback3].filter(Boolean),i=+(this.dataset.step||0);if(i<s.length){this.dataset.step=i+1;this.src=s[i];if(this.src.includes('capsule_231x87'))this.classList.add('is-lowres')}else{this.onerror=null}"
                alt={deal.title}
                loading="lazy"
                decoding="async"
                width="616"
                height="353"
              />
            )}
          </span>
          <span class="card__body">
            <span class="card__cat">−{deal.discount}% · Steam</span>
            <span class="card__title">{deal.title}</span>
            <span class="card__excerpt">{dealInfo(deal)}</span>
            <span class="card__meta">${deal.normal.toFixed(2)} → ${deal.sale.toFixed(2)} · Открыть →</span>
          </span>
        </a>
      ))}
    </div>

    <section class="nav-random" id="nav-random" hidden={mode !== 'nav' || navKey !== 'random'}>
      <p class="nav-random__lead">
        Не можете выбрать? Нажмите «Крутить» — выпадет случайная игра из базы приложения.
      </p>

      <div class="random-controls">
        <input id="random-q" class="random-search" type="search" placeholder="Фильтр по названию…" autocomplete="off" />
        <button class="btn" id="random-roll" type="button">Крутить</button>
