          class="card nav-card"
          href={game.url}
          target="_blank"
          rel="nofollow noopener"
          data-nav-item
          data-hay={`${game.title} ${game.note} ${game.req} ${game.ram} ${game.gpu}`.toLowerCase()}
          title={game.req}
        >
          <span class="card__thumb">
            {game.image && (
              <img
                src={game.image}
                class={game.image.includes('capsule_231x87') ? 'is-lowres' : undefined}
                data-fallback={game.imageFallback}
                data-fallback2={`${base}/icon.svg`}
                onerror="const s=[this.dataset.fallback,this.dataset.fallback2,this.dataset.fallback3].filter(Boolean),i=+(this.dataset.step||0);if(i<s.length){this.dataset.step=i+1;this.src=s[i];if(this.src.includes('capsule_231x87'))this.classList.add('is-lowres')}else{this.onerror=null}"
                alt={game.title}
                loading="lazy"
                decoding="async"
                width="616"
                height="353"
              />
            )}
          </span>
          <span class="card__body">
            <span class="card__cat">Без видеокарты</span>
            <span class="card__title">{game.title}</span>
            <span class="card__excerpt">{game.note || game.req}</span>
            <span class="card__meta">
              {game.ram ? `Мин. ОЗУ: ${game.ram.replace(/\s*ОЗУ/i, '')}` : 'Встроенная графика'} · Steam →
            </span>
          </span>
