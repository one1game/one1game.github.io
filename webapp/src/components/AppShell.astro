                ))}
              </div>
            </>
          )}
          {movieData?.trivia?.length > 0 && (
            <>
              <h2>Интересные факты</h2>
              <ul class="movie-list">{movieData.trivia.map((fact: string) => <li>{fact}</li>)}</ul>
