      )}
      <div class="reader__top">
        <button class="back" id="movie-back" type="button">
          <span aria-hidden="true">←</span> Назад
        </button>
        <span class="reader__cat" id="m-cat">
          {movieData ? (movieData.section === 'upcoming' ? 'Скоро на экранах' : 'Фильм по игре') : 'Фильм по игре'}
        </span>
        <span class="reader__meta" id="m-meta">{movieData?.date}</span>
      </div>
      <div class="movie-detail">
        <div class="movie-detail__hero">
          <div class="movie-detail__poster" id="m-poster">
            {movieData?.poster && (
              <img
                src={movieData.poster}
                alt={`${movieData.title} — постер`}
