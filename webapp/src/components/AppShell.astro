          <div class="movie-detail__info">
            {movieData
              ? <h1 id="m-title">{movieData.title}</h1>
              : <h2 id="m-title"></h2>}
            <p class="movie-detail__tagline" id="m-tagline" hidden={!movieData?.tagline}>{movieData?.tagline}</p>
            <div class="movie-detail__facts" id="m-facts">
              {movieData?.facts?.map((fact: string) => {
                const idx = fact.indexOf(':');
                return idx < 0
                  ? <span>{fact}</span>
                  : <span>{fact.slice(0, idx)}: <b>{fact.slice(idx + 1).trim()}</b></span>;
              })}
            </div>
          </div>
        </div>
        <div class="article-body" id="m-body">
          {movieData?.trailer && (
            <>
              <h2>Трейлер</h2>
              <div class="movie-trailer">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${movieData.trailer}`}
                  title={`${movieData.title} — трейлер`}
                  loading="lazy"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            </>
          )}
          {movieData?.plot && (
            <>
              <h2>Сюжет</h2>
              <p>{movieData.plot}</p>
            </>
          )}
          {movieData?.factsList?.length > 0 && (
            <>
              <h2>Факты о фильме</h2>
              <ul class="movie-list">{movieData.factsList.map((fact: string) => <li>{fact}</li>)}</ul>
            </>
          )}
          {movieData?.cast?.length > 0 && (
            <>
              <h2>В ролях</h2>
              <div class="movie-cast">
                {movieData.cast.map((person: any) => (
