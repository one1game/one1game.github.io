      <div class="music-tools" id="oboi-tools" hidden={mode !== 'oboi'}>
        <div class="sorts" id="oboi-sorts" role="group" aria-label="Сортировка обоев">
          <button class="sort" type="button" data-wall-sort="favorites" aria-pressed="true">Популярные</button>
          <button class="sort" type="button" data-wall-sort="toplist" aria-pressed="false">Лучшие за год</button>
          <button class="sort" type="button" data-wall-sort="date_added" aria-pressed="false">Новые</button>
          <button class="sort" type="button" data-wall-sort="random" aria-pressed="false">Случайные</button>
        </div>
