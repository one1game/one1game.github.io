    data-pre={movieData ? '1' : undefined}
  >
    <div class="wrap">
      {movieData && (
        <nav class="crumbs" aria-label="Хлебные крошки">
          <a href={`${base}/`}>Главная</a>
          <span aria-hidden="true">/</span>
          <a href={`${base}/movie/`}>Фильмы по играм</a>
