        <button class="chip" type="button" data-cat={c} aria-pressed={String(activeCat === c)}>{c}</button>
      ))}
    </div>
    <div class="wrap chips" data-chips="music" hidden={mode !== 'music'}>
      <button class="chip" type="button" data-cat="all" aria-pressed={String(activeCat === 'all')}>Все</button>
