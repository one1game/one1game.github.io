---
// Рекламный баннер Neuroplace AI. Живёт внутри сетки публикаций и занимает
// всю ширину ряда: на десктопе встаёт вторым рядом после первых карточек.
---

<aside class="grid-banner">
  <a
    class="neuro-banner"
    id="neuro-banner"
    href="https://neuroplace.ai/auth/register?referralCode=043da34aae05"
    target="_blank"
    rel="sponsored noopener noreferrer"
  >
    <canvas class="neuro-banner__canvas" id="neuro-canvas" aria-hidden="true"></canvas>

    <span class="neuro-banner__content">
      <span class="neuro-banner__tag">Новый уровень контента</span>
      <span class="neuro-banner__title">
        Преврати любое фото в <span>магию ИИ</span>
      </span>
      <span class="neuro-banner__subtitle">
        Seedance 2.5, Sora 2 и Nano Banana Pro в одном месте.
        Создавай вирусные видео и тренды без навыков монтажа.
      </span>
      <span class="neuro-banner__cta-wrap">
        <span class="neuro-banner__cta">
          Попробовать бесплатно
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
        <span class="neuro-banner__note">Бесплатные кредиты уже начислены на новый аккаунт</span>
      </span>
    </span>
  </a>
</aside>

<style>
  .grid-banner {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .neuro-banner {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    background: #030305;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(0, 240, 255, 0.05);
    transition: border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .neuro-banner:hover {
    border-color: rgba(0, 240, 255, 0.2);
    box-shadow:
      0 30px 60px -12px rgba(0, 0, 0, 0.95),
      0 0 40px rgba(0, 240, 255, 0.1);
  }

  .neuro-banner__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .neuro-banner__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(220px, 25vw, 340px);
    padding: clamp(22px, 3.6vw, 42px) clamp(22px, 5vw, 56px);
    background: linear-gradient(
      90deg,
      rgba(3, 3, 5, 0.96) 0%,
      rgba(3, 3, 5, 0.82) 44%,
      rgba(3, 3, 5, 0.28) 78%,
      rgba(3, 3, 5, 0) 100%
    );
  }

  .neuro-banner__tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin-bottom: 14px;
    padding: 5px 11px;
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: 6px;
    background: rgba(0, 240, 255, 0.08);
    color: #00f0ff;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }

  .neuro-banner__tag::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #00f0ff;
    box-shadow: 0 0 8px rgba(0, 240, 255, 0.9);
  }

  .neuro-banner__title {
    max-width: 620px;
    margin: 0 0 12px;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.1vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .neuro-banner__title span {
    background: linear-gradient(135deg, #00f0ff 0%, #bc13fe 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 14px rgba(0, 240, 255, 0.35));
  }

  .neuro-banner__subtitle {
    max-width: 520px;
    margin: 0 0 24px;
    color: rgba(255, 255, 255, 0.76);
    font-size: clamp(0.86rem, 1.1vw, 1rem);
    font-weight: 400;
    line-height: 1.55;
  }

  .neuro-banner__cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .neuro-banner__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 26px;
    border-radius: 8px;
    background: #ffffff;
    color: #030305;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.14), 0 4px 15px rgba(0, 0, 0, 0.3);
    transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .neuro-banner:hover .neuro-banner__cta {
    background: linear-gradient(90deg, #00f0ff 0%, #00c3cc 100%);
    transform: translateY(-2px);
    box-shadow: 0 0 34px rgba(0, 240, 255, 0.5);
  }

  .neuro-banner:active .neuro-banner__cta {
    transform: translateY(0) scale(0.985);
  }

  .neuro-banner__cta svg {
    transition: transform 0.25s ease;
  }

  .neuro-banner:hover .neuro-banner__cta svg {
    transform: translateX(4px);
  }

  .neuro-banner:focus-visible {
    outline: 2px solid rgba(0, 240, 255, 0.7);
    outline-offset: 3px;
  }

  .neuro-banner__note {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.76rem;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .neuro-banner__content {
      min-height: 0;
      padding: 26px 20px 28px;
      background: linear-gradient(
        180deg,
        rgba(3, 3, 5, 0.94) 0%,
        rgba(3, 3, 5, 0.86) 58%,
        rgba(3, 3, 5, 0.96) 100%
      );
    }

    .neuro-banner__title {
      max-width: 100%;
      font-size: clamp(1.25rem, 6vw, 1.9rem);
    }

    .neuro-banner__subtitle {
      max-width: 100%;
      margin-bottom: 20px;
    }

    .neuro-banner__cta-wrap {
      width: 100%;
    }

    .neuro-banner__cta {
      justify-content: center;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .neuro-banner,
    .neuro-banner__cta {
      transition: none;
    }
  }
</style>

<script>
  const canvas = document.getElementById('neuro-canvas') as HTMLCanvasElement | null;
  const banner = document.getElementById('neuro-banner');

  if (canvas && banner) {
    const ctx = canvas.getContext('2d');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (ctx && !reduce) {
      let width = 0;
      let height = 0;
      let particles: Particle[] = [];
      let animationId = 0;
      let time = 0;

      const config = {
        baseSpeed: 0.7,
        trailLength: 8,
        colors: { cyan: '0, 240, 255', purple: '188, 19, 254' },
      };

      const mouse = { x: -1000, y: -1000, active: false };

      class Particle {
        x = 0;
        y = 0;
        vx = 0;
        vy = 0;
        life = 0;
        colorType: 'cyan' | 'purple' = 'cyan';
        history: Array<{ x: number; y: number }> = [];

        constructor() {
          this.reset();
          this.x = Math.random() * width;
          this.y = Math.random() * height;
        }

        reset() {
          this.x = Math.random() * width * 1.2;
          this.y = Math.random() * height;
          this.vx = 0;
          this.vy = 0;
          this.life = Math.random() * 150 + 100;
          this.colorType = Math.random() > 0.5 ? 'purple' : 'cyan';
          this.history = [];
        }

        update() {
          this.history.push({ x: this.x, y: this.y });
          if (this.history.length > config.trailLength) this.history.shift();

          const scale = 0.0025;
          const angle = (Math.sin(this.x * scale + time * 0.3) + Math.cos(this.y * scale + time * 0.4)) * Math.PI * 2;
          let targetVx = Math.cos(angle) * config.baseSpeed;
          let targetVy = Math.sin(angle) * config.baseSpeed;

          if (mouse.active) {
            const dx = this.x - mouse.x;
            const dy = this.y - mouse.y;
            const dist = Math.hypot(dx, dy) || 1;
            if (dist < 180) {
              const force = (180 - dist) / 180;
              targetVx += (dx / dist) * force * 1.5;
              targetVy += (dy / dist) * force * 1.5;
            }
          }

          this.vx += (targetVx - this.vx) * 0.08;
          this.vy += (targetVy - this.vy) * 0.08;
          this.x += this.vx;
          this.y += this.vy;
          this.life -= 1;

          if (this.life <= 0 || this.x < -50 || this.x > width + 50 || this.y < -50 || this.y > height + 50) {
            this.reset();
          }
        }

        draw() {
          if (!ctx || this.history.length < 2) return;
          const color = this.colorType === 'cyan' ? config.colors.cyan : config.colors.purple;

          ctx.beginPath();
          ctx.moveTo(this.history[0].x, this.history[0].y);
          for (let i = 1; i < this.history.length; i += 1) {
            ctx.lineTo(this.history[i].x, this.history[i].y);
          }
          ctx.strokeStyle = `rgba(${color}, 0.3)`;
          ctx.lineWidth = this.colorType === 'cyan' ? 1.5 : 1;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(this.x, this.y, this.colorType === 'cyan' ? 2 : 1.5, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${color}, 0.9)`;
          ctx.shadowBlur = this.colorType === 'cyan' ? 12 : 15;
          ctx.shadowColor = `rgba(${color}, 0.8)`;
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }

      function init() {
        if (!banner) return;
        const rect = banner.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const count = Math.floor((width * height) / 9000);
        particles = [];
        for (let i = 0; i < count; i += 1) particles.push(new Particle());
      }

      function animate() {
        ctx.fillStyle = 'rgba(3, 3, 5, 0.2)';
        ctx.fillRect(0, 0, width, height);
        time += 0.004;
        for (const particle of particles) {
          particle.update();
          particle.draw();
        }
        animationId = requestAnimationFrame(animate);
      }

      function start() {
        if (animationId) return;
        animationId = requestAnimationFrame(animate);
      }

      function stop() {
        cancelAnimationFrame(animationId);
        animationId = 0;
      }

      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          stop();
          init();
          start();
        }, 150);
      });

      banner.addEventListener('mousemove', (e) => {
        const rect = banner.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.active = true;
      });

      banner.addEventListener('mouseleave', () => {
        mouse.active = false;
        mouse.x = -1000;
        mouse.y = -1000;
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) start();
          else stop();
        }
      }, { threshold: 0.1 });

      observer.observe(banner);
      init();
      start();
    }
  }
</script>
