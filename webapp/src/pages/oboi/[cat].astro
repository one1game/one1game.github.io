---
import AppShell from '../../components/AppShell.astro';
import oboi from '../../data/oboi.json';
import archive from '../../../public/oboi.json';
import { fitTitle } from '../../lib/seo';

const site = 'https://one1game.org';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export function getStaticPaths() {
  const categories = oboi.categories.filter((category: any) => category.key !== 'all');
  return categories.map((category: any) => ({
    params: { cat: category.key },
    props: { category },
  }));
}

const { category } = Astro.props as { category: any };
const url = `${site}${base}/oboi/${category.key}/`;
const walls = (archive.items[category.key] || []).slice(0, 24);
const description =
  `Обои ${category.label.toLowerCase()} для рабочего стола и телефона: ${category.count.toLocaleString('ru-RU')} изображений в 4K и Full HD. Скачивание без регистрации и водяных знаков.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: `Обои: ${category.label}`,
    description,
    url,
    inLanguage: 'ru-RU',
    isPartOf: { '@type': 'WebSite', name: 'One1Game', url: `${site}${base}/` },
    image: walls.map((wall: any) => ({
      '@type': 'ImageObject',
      contentUrl: wall.full,
      thumbnailUrl: wall.thumb,
      width: wall.w,
      height: wall.h,
      name: `Обои ${wall.res} — ${category.label}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site}${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Обои', item: `${site}${base}/oboi/` },
      { '@type': 'ListItem', position: 3, name: category.label, item: url },
    ],
  },
];
---

<AppShell
  mode="oboi"
  variant="section"
  cat={category.key}
  walls={walls}
  seoTitle={fitTitle(`Обои ${category.label} — скачать бесплатно`)}
  seoDescription={description}
  seoImage={walls[0]?.thumb}
  jsonLd={jsonLd}
/>
