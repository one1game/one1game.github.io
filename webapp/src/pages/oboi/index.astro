---
import AppShell from '../../components/AppShell.astro';
import oboi from '../../data/oboi.json';
import archive from '../../../public/oboi.json';

const site = 'https://one1game.org';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = `${site}${base}/oboi/`;
const walls = (archive.items.all || []).slice(0, 24);
const description =
  `Обои для рабочего стола и телефона: игры, неон, киберпанк, аниме, тёмные и минималистичные. ${oboi.total.toLocaleString('ru-RU')} изображений в 4K и Full HD — скачивание в один клик.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: 'Обои One1Game',
    description,
    url,
    inLanguage: 'ru-RU',
    isPartOf: { '@type': 'WebSite', name: 'One1Game', url: `${site}${base}/` },
    image: walls.map((wall: any) => ({
      '@type': 'ImageObject',
      contentUrl: wall.full,
      thumbnailUrl: wall.thumb,
      width: wall.w,
      height: wall.h,
      name: `Обои ${wall.res}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site}${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Обои', item: url },
    ],
  },
];
---

<AppShell
  mode="oboi"
  variant="section"
  walls={walls}
  seoTitle="Обои для рабочего стола — 4K и Full HD — One1Game"
  seoDescription={description}
  seoImage={walls[0]?.thumb}
  jsonLd={jsonLd}
/>
