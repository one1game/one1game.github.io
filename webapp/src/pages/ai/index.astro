---
import AppShell from '../../components/AppShell.astro';
import ai from '../../data/ai.json';

const site = 'https://one1game.org';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = `${site}${base}/ai/`;

const description =
  `Новости искусственного интеллекта, рейтинг моделей по объёму токенов OpenRouter, ` +
  `${ai.tools.length} инструментов и ${ai.free.length} бесплатных нейросетей без ключа. Обновляется ежедневно.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'AI Pulse — новости, модели и инструменты ИИ',
    description,
    url,
    inLanguage: 'ru-RU',
    isPartOf: { '@type': 'WebSite', name: 'One1Game', url: `${site}${base}/` },
    dateModified: ai.updatedISO,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: ai.news.length,
      itemListElement: ai.news.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Article',
          headline: item.title,
          url: item.link,
          datePublished: item.dateISO,
          articleSection: item.categoryRu,
          publisher: { '@type': 'Organization', name: item.source },
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site}${base}/` },
      { '@type': 'ListItem', position: 2, name: 'ИИ', item: url },
    ],
  },
];
---

<AppShell
  mode="ai"
  variant="section"
  seoTitle="ИИ: новости, рейтинг нейросетей и бесплатные модели — One1Game"
  seoDescription={description}
  jsonLd={jsonLd}
/>
