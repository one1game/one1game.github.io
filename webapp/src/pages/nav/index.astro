---
import AppShell from '../../components/AppShell.astro';
import navigator from '../../data/navigator.json';

const site = 'https://one1game.org';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = `${site}${base}/nav/`;
const collectionCount = navigator.collections.length;
const description =
  `Игровой навигатор One1Game: ${navigator.giveaways.length} бесплатных раздач, ${navigator.deals.length} скидок Steam и ${navigator.lowend.length} игр для слабых ПК. Обновляется автоматически.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Игровой навигатор',
    description,
    url,
    inLanguage: 'ru-RU',
    isPartOf: { '@type': 'WebSite', name: 'One1Game', url: `${site}${base}/` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: collectionCount,
      itemListElement: navigator.collections.map((collection: any, index: number) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: collection.label,
        description: collection.desc,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site}${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Игровой навигатор', item: url },
    ],
  },
];
---

<AppShell
  mode="nav"
  variant="section"
  seoTitle="Игровой навигатор — скидки и раздачи игр — One1Game"
  seoDescription={description}
  jsonLd={jsonLd}
/>
