---
import AppShell from '../../components/AppShell.astro';
import { fitTitle } from '../../lib/seo';
import movies from '../../data/movies.json';

const site = 'https://one1game.org';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export function getStaticPaths() {
  const eager = import.meta.glob('../../../public/movies/*.json', { eager: true }) as Record<
    string,
    { default: any }
  >;
  return Object.values(eager)
    .map((mod) => mod.default ?? mod)
    .map((movie) => ({ params: { id: movie.id }, props: { movie } }));
}

const { movie } = Astro.props as { movie: any };
const index = movies.items.find((item: any) => item.id === movie.id);
const url = `${site}${base}/movie/${movie.id}/`;
const description = String(movie.overview || movie.title).slice(0, 160);
const genres = index?.genres
  ? String(index.genres).split(',').map((genre: string) => genre.trim()).filter(Boolean)
  : [];

const MONTHS: Record<string, string> = {
  января: '01', февраля: '02', марта: '03', апреля: '04', мая: '05', июня: '06',
  июля: '07', августа: '08', сентября: '09', октября: '10', ноября: '11', декабря: '12',
};
const dateMatch = String(movie.date || '').match(/^(\d{1,2})\s+([а-яё]+)\s+(\d{4})$/i);
const dateISO = dateMatch && MONTHS[dateMatch[2].toLowerCase()]
  ? `${dateMatch[3]}-${MONTHS[dateMatch[2].toLowerCase()]}-${dateMatch[1].padStart(2, '0')}`
  : '';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Movie',
    name: movie.title,
    description: movie.overview,
    image: movie.poster || undefined,
    url,
    inLanguage: 'ru-RU',
    datePublished: dateISO || undefined,
    genre: genres.length ? genres : undefined,
    actor: (movie.cast || []).slice(0, 10).map((person: any) => ({
      '@type': 'Person',
      name: person.name,
    })),
    trailer: movie.trailer
      ? {
          '@type': 'VideoObject',
          name: `${movie.title} — трейлер`,
          embedUrl: `https://www.youtube-nocookie.com/embed/${movie.trailer}`,
          thumbnailUrl: `https://i.ytimg.com/vi/${movie.trailer}/hqdefault.jpg`,
        }
      : undefined,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${site}${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Фильмы по играм', item: `${site}${base}/movie/` },
      { '@type': 'ListItem', position: 3, name: movie.title, item: url },
    ],
  },
];
---

<AppShell
  mode="movie"
  movie={movie.id}
  variant="movie-item"
  movieData={movie}
  seoTitle={fitTitle(movie.title, ' — фильм по игре — One1Game')}
  seoDescription={description}
  seoImage={movie.poster}
  jsonLd={jsonLd}
/>
