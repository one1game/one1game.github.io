# Заголовки для Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400

# Sitemap и фиды краулеры забирают часто, а отдавались с TTFB > 1 с и без кэша
# на краю (cf-cache-status: DYNAMIC). 10 минут кэша экономят обход.
/*.xml
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/robots.txt
  Cache-Control: public, max-age=0, s-maxage=3600

/sw.js
  Cache-Control: no-cache

/img/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/oboi/data.json
  Cache-Control: public, max-age=3600

/oboi/*.js
  Cache-Control: public, max-age=604800

/oboi/*.css
  Cache-Control: public, max-age=604800

/oboi/og-oboi.jpg
  Cache-Control: public, max-age=31536000, immutable

/music/data.json
  Cache-Control: public, max-age=3600

/music/*.js
  Cache-Control: public, max-age=604800

/music/*.css
  Cache-Control: public, max-age=604800

/music/og-music.jpg
  Cache-Control: public, max-age=31536000, immutable
